{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "duck-error-example-nestjs",
  "private": true,
  "version": "0.0.0",
  "description": "Runnable NestJS example wiring @gentleduck/errors through an ExceptionFilter.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "clean": "rimraf dist .cache .turbo node_modules"
  },
  "dependencies": {
    "@gentleduck/errors": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@gentleduck/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.5",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
