{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "sherif": "1.11.1",
    "turbo": "^2.9.18",
    "typescript": "^7.0.2"
  },
  "name": "duck-error",
  "description": "Typed, registry-driven error classes for TypeScript: branded codes, secret-safe serialization, and framework adapters. Monorepo for @gentleduck/errors.",
  "author": "gentleduck contributors",
  "license": "MIT",
  "homepage": "https://gentleduck.org/duck-error",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-error.git"
  },
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-error/issues"
  },
  "keywords": [
    "gentleduck",
    "duck-error",
    "errors",
    "error-handling",
    "typescript"
  ],
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "biome check packages/ tooling/ apps/ examples/",
    "lint": "biome lint packages/ tooling/ apps/ examples/",
    "format": "biome format --write packages/ tooling/ apps/ examples/",
    "fix": "biome check --write packages/ tooling/ apps/ examples/",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci": "bun run check && bun run lint:ws && bun run check-types && bun run test && bun run build",
    "release": "bunx turbo run build --filter='./packages/*' && changeset publish",
    "clean": "rimraf dist .cache .turbo node_modules .next .velite",
    "clean:git": "git clean -xdf .cache .turbo node_modules dist",
    "lint:ws": "sherif -i typescript",
    "postinstall": "bun run lint:ws || true",
    "prepare": "husky",
    "check-types": "turbo run check-types",
    "scorecard": "bash scripts/scorecard.sh",
    "scorecard:local": "bash scripts/scorecard.sh --local"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "tooling/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "tsdown": "^0.22.3",
      "typescript": "^7.0.2",
      "vitest": "^4.1.9"
    }
  }
}
